# Supabase project settings (Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Shared 4-digit staff PIN for the Doctor View gate.
# Changing this requires editing this file and redeploying.
VITE_STAFF_PIN=1234

# Inactivity timeouts, in seconds. Optional — sensible defaults are used if omitted.
VITE_IDLE_TIMEOUT_LOOKUP=60
VITE_IDLE_TIMEOUT_PLAYER=120
VITE_IDLE_TIMEOUT_DOCTOR=180

# Shows a persistent "DEMO / TEST DATA" banner on every screen. Set to
# "false" once the database holds real content and real patients — until
# then this stays visible as a guardrail against mistaking a test session
# (or a screenshot of one) for a live clinical deployment.
VITE_DEMO_MODE=true
